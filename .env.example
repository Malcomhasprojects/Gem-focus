# Local development (Next.js API routes + MySQL)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=gem_focus

# Or a single URL:
# DATABASE_URL=mysql://root@127.0.0.1:3306/gem_focus

ADMIN_ACCESS_KEY=1111

# Static InfinityFree build uses PHP at /api/*.php (default in production).
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_API_EXT=.php

# Optional: FTP upload after build:deploy (InfinityFree → FTP Details)
# FTP_HOST=ftpupload.net
# FTP_USER=if0_XXXXXXX
# FTP_PASSWORD=
# FTP_REMOTE_DIR=/htdocs
